{
  "name": "pecunio",
  "version": "0.5.3",
  "private": true,
  "description": "Extension Chrome qui enrichit Bankin avec des visualisations financières",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:tz": "node scripts/test-timezones.mjs",
    "test:bugs": "vitest run --mode bugs",
    "snapshot:snippet": "node scripts/print-snapshot-snippet.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chrome": "^0.3.7",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "chart.js": "4.6.1",
    "chartjs-adapter-date-fns": "3.0.0",
    "chartjs-chart-sankey": "0.22.0",
    "choices.js": "11.2.4",
    "date-fns": "4.4.0",
    "html2pdf.js": "0.14.0"
  }
}
